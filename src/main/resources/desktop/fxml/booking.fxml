<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fu.cinema.desktop.controller.BookingController"
            styleClass="page">
    <top>
        <VBox spacing="12">
            <BorderPane.margin>
                <Insets bottom="12"/>
            </BorderPane.margin>
            <Label text="Quản lý đơn đặt vé" styleClass="page-title"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <ComboBox fx:id="cbStatus" prefWidth="160"/>
                <DatePicker fx:id="dpFrom" promptText="Từ ngày" prefWidth="130"/>
                <DatePicker fx:id="dpTo" promptText="Đến ngày" prefWidth="130"/>
                <TextField fx:id="tfKeyword" promptText="Khách hàng / SĐT" HBox.hgrow="ALWAYS"/>
                <Button text="Lọc" onAction="#onSearch" styleClass="primary"/>
                <Button text="Làm lại" onAction="#onReset"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="8">
            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="Mã đơn" prefWidth="75"/>
                    <TableColumn fx:id="colCustomer" text="Khách hàng" prefWidth="150"/>
                    <TableColumn fx:id="colMovie" text="Phim" prefWidth="160"/>
                    <TableColumn fx:id="colRoom" text="Phòng" prefWidth="85"/>
                    <TableColumn fx:id="colShowtime" text="Suất chiếu" prefWidth="105"/>
                    <TableColumn fx:id="colSeats" text="Số vé" prefWidth="60"/>
                    <TableColumn fx:id="colTotal" text="Tổng tiền" prefWidth="110"/>
                    <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="110"/>
                    <TableColumn fx:id="colBookingDate" text="Ngày đặt" prefWidth="130"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            <Pagination fx:id="pagination" maxPageIndicatorCount="7"/>
        </VBox>
    </center>
    <bottom>
        <HBox spacing="12" alignment="CENTER_RIGHT">
            <BorderPane.margin>
                <Insets top="10"/>
            </BorderPane.margin>
            <Button fx:id="btnDetail" text="Xem chi tiết" onAction="#onDetail"/>
            <Button fx:id="btnConfirm" text="Xác nhận đơn" onAction="#onConfirm" styleClass="primary"/>
            <Button fx:id="btnCancel" text="Huỷ đơn" onAction="#onCancel" style="-fx-text-fill: #b91c1c;"/>
        </HBox>
    </bottom>
</BorderPane>

