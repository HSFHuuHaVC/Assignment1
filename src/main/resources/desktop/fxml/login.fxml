<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox alignment="CENTER" styleClass="login" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fu.cinema.desktop.controller.LoginController">
    <VBox fx:id="form" spacing="14" styleClass="login-card" alignment="CENTER_LEFT">
        <Label text="FU CINEMA" styleClass="brand"/>
        <Label text="Đăng nhập quầy vé" styleClass="page-title"/>
        <Label text="Dành cho nhân viên có tài khoản ADMIN." styleClass="login-caption"/>
        <Label text="Email đăng nhập" labelFor="$tfUsername"/>
        <TextField fx:id="tfUsername" promptText="Email đăng nhập" maxWidth="Infinity"/>
        <Label text="Mật khẩu" labelFor="$pfPassword"/>
        <PasswordField fx:id="pfPassword" promptText="Mật khẩu" maxWidth="Infinity"/>
        <Button fx:id="btnLogin" text="Đăng nhập" defaultButton="true" onAction="#onLogin" styleClass="primary" maxWidth="Infinity"/>
        <ProgressIndicator fx:id="progress" visible="false" prefWidth="28" prefHeight="28"/>
    </VBox>
</VBox>
